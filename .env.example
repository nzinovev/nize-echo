# Local development defaults; `make dev` sets these already.
SITE_ADDR=:8080
LOG_LEVEL=debug
ADMIN_DEV_URL=http://localhost:5173
# Host port for the compose Postgres, if 5432 is taken (docker compose reads .env).
POSTGRES_PORT=5432
DATABASE_URL=postgres://nize:nize@localhost:5432/nize_echo?sslmode=disable
TEST_DATABASE_URL=postgres://nize:nize@localhost:5432/nize_echo?sslmode=disable
